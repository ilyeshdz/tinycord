---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-surface text-primary">
    <Header />

    <main class="mx-auto max-w-4xl px-4">
      <section class="flex flex-col items-center py-24 sm:py-32 text-center">
        <div class="text-accent mb-6">
          <svg viewBox="0 0 28 28" width="28" height="28" fill="none">
            <rect x="1" y="1" width="26" height="26" rx="6" stroke="currentColor" stroke-width="2" />
            <circle cx="14" cy="14" r="4" fill="currentColor" />
          </svg>
        </div>
        <h1 class="text-5xl sm:text-6xl font-bold tracking-tight m-0">
          Tinycord
        </h1>
        <p class="text-secondary mt-4 max-w-md text-lg sm:text-xl leading-relaxed">
          {SITE_DESCRIPTION}
        </p>
        <div class="mt-8 flex gap-3">
          <a
            href="/download"
            class="inline-flex h-10 items-center gap-2 rounded-lg bg-accent px-5 text-sm font-medium text-white no-underline transition-all hover:opacity-85"
          >
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14" class="shrink-0">
              <path d="M8 2v9M4 7l4 4 4-4" />
              <path d="M3 12v1a1 1 0 001 1h8a1 1 0 001-1v-1" />
            </svg>
            Download
          </a>
          <a
            href="https://github.com/ilyeshdz/tinycord"
            class="inline-flex h-10 items-center gap-2 rounded-lg border border-default bg-muted px-5 text-sm font-medium text-primary no-underline transition-all hover:bg-surface hover:border-primary"
          >
            <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14" class="shrink-0">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            </svg>
            Source
          </a>
        </div>
      </section>

      <section class="grid gap-4 pb-24 sm:grid-cols-2">
        <article class="rounded-xl border border-default bg-muted p-5">
          <div class="text-tertiary mb-3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
              <path d="M12 3v14M9 14l3 3 3-3" />
              <path d="M4 21h16" />
            </svg>
          </div>
          <h2 class="text-sm font-semibold tracking-tight m-0 text-primary">
            Lightweight
          </h2>
          <p class="text-secondary text-sm mt-1.5 m-0 leading-relaxed">
            No Electron. No bloat. Native app built with Zig and WebView, under 5 MB.
          </p>
        </article>
        <article class="rounded-xl border border-default bg-muted p-5">
          <div class="text-tertiary mb-3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
              <path d="M12 2l7 3v7c0 4-3.5 7.5-7 9-3.5-1.5-7-5-7-9V5l7-3z" />
            </svg>
          </div>
          <h2 class="text-sm font-semibold tracking-tight m-0 text-primary">
            Secure
          </h2>
          <p class="text-secondary text-sm mt-1.5 m-0 leading-relaxed">
            Minimal attack surface. Only connects to Discord directly. Camera and mic permissions are opt-in.
          </p>
        </article>
        <article class="rounded-xl border border-default bg-muted p-5">
          <div class="text-tertiary mb-3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
              <rect x="3" y="4" width="18" height="14" rx="2" />
              <path d="M8 22h8" />
              <path d="M12 18v4" />
            </svg>
          </div>
          <h2 class="text-sm font-semibold tracking-tight m-0 text-primary">
            Cross-platform
          </h2>
          <p class="text-secondary text-sm mt-1.5 m-0 leading-relaxed">
            Works on macOS, Windows, and Linux with native feel on each platform.
          </p>
        </article>
        <article class="rounded-xl border border-default bg-muted p-5">
          <div class="text-tertiary mb-3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
              <path d="M1 12s3-7 11-7 11 7 11 7-3 7-11 7-11-7-11-7z" />
              <circle cx="12" cy="12" r="3" />
              <path d="M2 2l20 20" />
            </svg>
          </div>
          <h2 class="text-sm font-semibold tracking-tight m-0 text-primary">
            No telemetry
          </h2>
          <p class="text-secondary text-sm mt-1.5 m-0 leading-relaxed">
            Zero analytics, no tracking, no background processes. Just Discord.
          </p>
        </article>
      </section>
    </main>

    <Footer />
  </body>
</html>
