---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title="Tinycord"
  description="A secure, lightweight alternative to the official Discord client."
>
  <section class="hero">
    <h1>A secure, lightweight<br />Discord client.</h1>
    <p>
      Tinycord is a tiny desktop wrapper that loads Discord in a native webview.
      No Electron. No bloat. Written in Zig.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="https://github.com/ilyeshdz/tinycord/releases">
        <Icon name="simple-icons:apple" />
        Download for macOS
      </a>
      <a class="btn" href="https://github.com/ilyeshdz/tinycord">
        <Icon name="simple-icons:github" />
        Star on GitHub
      </a>
    </div>
  </section>

  <section class="section">
    <h2>Native. Not Electron.</h2>
    <p>
      Built with Zig using a native webview. Tiny binaries, low memory, no bundled Chromium.
    </p>
  </section>

  <section class="section">
    <h2>Open source, MIT.</h2>
    <div class="grid">
      <div class="card">
        <h3>Zig</h3>
        <p>Fast, native code</p>
      </div>
      <div class="card">
        <h3>60 KB</h3>
        <p>Binary size</p>
      </div>
      <div class="card">
        <h3>Fork it</h3>
        <p>Easily customizable</p>
      </div>
    </div>
  </section>
</BaseLayout>
