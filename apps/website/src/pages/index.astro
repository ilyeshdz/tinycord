---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="py-16 sm:py-20">
  <section class="-mx-4 mb-16 sm:-mx-0">
    <div class="flex flex-col items-center text-center">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight m-0">
        Tinycord
      </h1>
      <p class="text-secondary mt-3 max-w-md text-base sm:text-lg">
        {SITE_DESCRIPTION}
      </p>
      <div class="mt-6 flex gap-3">
        <a href="/download" class="btn-primary">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="13" height="13" class="shrink-0">
            <path d="M8 2v9M4 7l4 4 4-4" />
            <path d="M3 12v1a1 1 0 001 1h8a1 1 0 001-1v-1" />
          </svg>
          Download
        </a>
        <a href="https://github.com/ilyeshdz/tinycord" class="btn-secondary">
          <svg viewBox="0 0 16 16" fill="currentColor" width="13" height="13" class="shrink-0">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
          Source
        </a>
      </div>
    </div>
  </section>

  <section>
    <div class="grid gap-3 sm:grid-cols-2">
      <article class="border border-default bg-muted p-4">
        <h2 class="text-sm font-semibold tracking-tight m-0 text-primary">Lightweight</h2>
        <p class="text-secondary text-sm mt-1 m-0">No Electron. No bloat. Native app built with Zig and WebView, under 5 MB.</p>
      </article>
      <article class="border border-default bg-muted p-4">
        <h2 class="text-sm font-semibold tracking-tight m-0 text-primary">Private</h2>
        <p class="text-secondary text-sm mt-1 m-0">No analytics, no tracking, no background processes. Just Discord.</p>
      </article>
      <article class="border border-default bg-muted p-4">
        <h2 class="text-sm font-semibold tracking-tight m-0 text-primary">Cross-platform</h2>
        <p class="text-secondary text-sm mt-1 m-0">Works on macOS, Windows, and Linux with native feel on each platform.</p>
      </article>
      <article class="border border-default bg-muted p-4">
        <h2 class="text-sm font-semibold tracking-tight m-0 text-primary">Open source</h2>
        <p class="text-secondary text-sm mt-1 m-0">MIT licensed. Full source on GitHub. Built in public, no secrets, no tricks.</p>
      </article>
    </div>
  </section>
</BaseLayout>
