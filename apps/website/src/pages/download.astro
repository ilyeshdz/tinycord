---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { SITE_TITLE } from '../consts';

interface Release {
  tag_name: string
  html_url: string
  assets: {
    name: string
    browser_download_url: string
  }[]
}

let release: Release | null = null
let error: string | null = null

try {
  const res = await fetch('https://api.github.com/repos/ilyeshdz/tinycord/releases/latest')
  if (res.ok) {
    release = await res.json()
  } else {
    error = `GitHub API returned ${res.status}`
  }
} catch {
  error = 'Could not fetch release data'
}

function find(re: RegExp) {
  return release?.assets.find(a => re.test(a.name))
}

const macAsset = find(/Darwin_arm64.*\.tar\.gz$/) || find(/Darwin_x86_64.*\.tar\.gz$/)
const winAsset = find(/Windows_x86_64.*\.zip$/)
---

const fallbackUrl = release?.html_url || 'https://github.com/ilyeshdz/tinycord/releases/latest'
---

<BaseLayout title={`Download - ${SITE_TITLE}`} description="Download Tinycord for your platform" mainClass="py-16">
  <h1 class="text-xl font-semibold tracking-tight m-0">Download</h1>

  {release && <p class="text-tertiary text-xs mt-1 m-0">{release.tag_name}</p>}
  {error && <p class="text-tertiary text-xs mt-1 m-0">{error}</p>}

  <div class="grid gap-3 sm:grid-cols-2">
    <article class="rounded-xl border border-default bg-muted p-5">
      <h2 class="text-sm font-semibold m-0 mb-1 text-primary">macOS</h2>
      <p class="text-secondary text-xs m-0 mb-3 leading-relaxed">
        Apple Silicon & Intel
      </p>
      {
        macAsset ? (
          <Button variant="primary" href={macAsset.browser_download_url}>Download {macAsset.name.replace(/\.(dmg|tar\.gz)$/, '')}</Button>
        ) : (
          <Button variant="primary" href={fallbackUrl}>Download from GitHub</Button>
        )
      }
    </article>

    <article class="rounded-xl border border-default bg-muted p-5">
      <h2 class="text-sm font-semibold m-0 mb-1 text-primary">Windows</h2>
      <p class="text-secondary text-xs m-0 mb-3 leading-relaxed">x86_64</p>
      {
        winAsset ? (
          <Button variant="primary" href={winAsset.browser_download_url}>Download {winAsset.name.replace(/\.(zip|exe)$/, '')}</Button>
        ) : (
          <Button variant="primary" href={fallbackUrl}>Download from GitHub</Button>
        )
      }
    </article>

    <article class="rounded-xl border border-default bg-muted p-5 opacity-60">
      <h2 class="text-sm font-semibold m-0 mb-1 text-primary">Linux</h2>
      <p class="text-secondary text-xs m-0 mb-1 leading-relaxed">
        Not available as a prebuilt binary yet.
      </p>
      <p class="text-tertiary text-xs m-0 leading-relaxed">
        Build from source. See the README for dependencies (WebKitGTK).
      </p>
    </article>
  </div>

  <section class="mt-12 pt-8 border-t border-default">
    <h2 class="text-sm font-semibold m-0 mb-3 text-primary">Build from source</h2>
    <div class="bg-muted rounded-lg p-4 text-sm font-mono text-secondary overflow-x-auto">
      <div>git clone https://github.com/ilyeshdz/tinycord.git</div>
      <div>cd tinycord/apps/desktop</div>
      <div class="text-tertiary"># install dependencies (see README)</div>
      <div>zig build app</div>
    </div>
  </section>
</BaseLayout>
