---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { SITE_TITLE } from '../consts';

interface Asset { name: string; browser_download_url: string }

interface Release { tag_name: string; html_url: string; assets: Asset[] }

interface Entry { arch: string; test: RegExp | ((name: string) => boolean) }

const osGroups: { os: string; entries: Entry[] }[] = [
  {
    os: 'macOS',
    entries: [
      { arch: 'Apple Silicon', test: /Darwin_arm64.*\.tar\.gz$/ },
      { arch: 'Intel',         test: /Darwin_x86_64.*\.tar\.gz$/ },
    ],
  },
  {
    os: 'Windows',
    entries: [
      { arch: 'x86_64', test: /Windows_x86_64.*\.zip$/ },
      { arch: 'ARM',    test: /Windows_arm64.*\.zip$/ },
    ],
  },
  { os: 'Linux', entries: [] },
]

let release: Release | null = null
let error: string | null = null

try {
  const res = await fetch('https://api.github.com/repos/ilyeshdz/tinycord/releases/latest')
  if (res.ok) release = await res.json()
  else error = `GitHub API returned ${res.status}`
} catch {
  error = 'Could not fetch release data'
}

function findAsset(test: Entry['test']): Asset | undefined {
  return release?.assets.find(a => test instanceof RegExp ? test.test(a.name) : test(a.name))
}

const fallbackUrl = release?.html_url || 'https://github.com/ilyeshdz/tinycord/releases/latest'
---

<BaseLayout title={`Download - ${SITE_TITLE}`} description="Download Tinycord for your platform" mainClass="py-16">
  <h1 class="text-xl font-semibold tracking-tight m-0">Download</h1>

  {release && <p class="text-tertiary text-xs mt-1 m-0">{release.tag_name}</p>}
  {error && <p class="text-tertiary text-xs mt-1 m-0">{error}</p>}

  <div class="mt-6 space-y-1">
    {
      osGroups.flatMap(({ os, entries }) =>
        os === 'Linux'
          ? [
              <div class="border border-default p-3 opacity-60">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-sm font-medium text-primary">{os}</span>
                  <span class="text-xs text-tertiary">source</span>
                </div>
                <div class="bg-muted p-3 text-xs font-mono text-secondary overflow-x-auto">
                  <div>git clone https://github.com/ilyeshdz/tinycord.git</div>
                  <div>cd tinycord/apps/desktop</div>
                  <div class="text-tertiary"># install deps (see README)</div>
                  <div>zig build app</div>
                </div>
              </div>,
            ]
          : entries.map(({ arch, test }) => {
              const asset = findAsset(test)
              return (
                <div class="flex items-center justify-between border border-default p-3">
                  <div>
                    <span class="text-sm font-medium text-primary">{os}</span>
                    <span class="text-xs text-secondary ml-2">{arch}</span>
                  </div>
                  <Button variant="primary" size="sm" href={asset?.browser_download_url || fallbackUrl}>Download</Button>
                </div>
              )
            })
      )
    }
  </div>
</BaseLayout>
