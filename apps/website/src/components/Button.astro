---
const {
    href,
    variant = "secondary",
    size = "md",
    disabled = false,
    type = "button",
    class: className = "",
} = Astro.props;

const variantClasses = {
    primary:
        "border-[#2dd4bf] bg-[#2dd4bf] text-[#0b1120] hover:opacity-80",
    secondary: "border-default bg-transparent text-primary",
    ghost: "border-transparent bg-transparent text-primary",
};

const sizeClasses = {
    sm: "h-8 px-3",
    md: "h-9 px-4",
    lg: "h-11 px-6",
};

const classes = [
    "inline-flex items-center justify-center gap-2 border font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2dd4bf] disabled:cursor-not-allowed disabled:opacity-60",
    variantClasses[variant] ?? variantClasses.secondary,
    sizeClasses[size] ?? sizeClasses.md,
    className,
]
    .filter(Boolean)
    .join(" ");
---

{
    href ? (
        <a
            href={href}
            class={classes}
            aria-disabled={disabled ? "true" : undefined}
            tabindex={disabled ? "-1" : undefined}
        >
            <slot />
        </a>
    ) : (
        <button type={type} class={classes} disabled={disabled}>
            <slot />
        </button>
    )
}
