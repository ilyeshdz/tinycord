---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
  mainClass?: string;
}

const { title, description = '', pageClass = '', mainClass = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {title} {description} />
  </head>
  <body class:list={['bg-surface text-primary', pageClass]}>
    <Header />
    <main class:list={['mx-auto w-full max-w-4xl px-4', mainClass]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
