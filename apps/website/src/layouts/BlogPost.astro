---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<BaseLayout {title} {description} mainClass="py-16">
  <article class="prose prose-invert">
    <div class="not-prose mb-10 text-center">
      <p class="text-secondary text-sm m-0">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span class="text-tertiary italic ml-2">
              (Updated <FormattedDate date={updatedDate} />)
            </span>
          )
        }
      </p>
      <h1 class="text-3xl font-bold tracking-tight m-0 mt-2 text-primary">
        {title}
      </h1>
    </div>
    <div class="border-t border-default mb-10" />
    <slot />
  </article>
</BaseLayout>
